###
# Create a catalog item for budget rollback and status tests
#
# @name createBudgetTestItem

POST {{ExpenseTrackerApi_HostAddress}}/api/v1/items
Content-Type: application/json
Accept: application/json

{
  "name": "Budget Test Item {{$guid}}",
  "code": "BT-{{$timestamp}}",
  "brand": "Budget Test Brand {{$guid}}",
  "unitPrice": 100.00
}


###
# Create a budget account for status mismatch tests
#
# @name createStatusTestBudgetAccount

POST {{ExpenseTrackerApi_HostAddress}}/api/v1/budget/accounts
Content-Type: application/json
Accept: application/json

{
  "name": "Status Test Budget Account {{$guid}}",
  "description": "Budget account used for status mismatch tests.",
  "balance": 1000.00
}


###
# Archive the budget account used for status mismatch tests
#
# Expected:
# - 200 OK
# - Status is Archived
# - No Adjustment log is created because the balance is unchanged

PATCH {{ExpenseTrackerApi_HostAddress}}/api/v1/budget/accounts/{{createStatusTestBudgetAccount.response.body.$.budgetAccountId}}
Content-Type: application/json
Accept: application/json

{
  "status": "Archived"
}


###
# Attempt to record an expense using an archived budget account
#
# Expected:
# - 409 Conflict
# - The expense entry and expense item are rolled back
# - No Expense budget log is created

POST {{ExpenseTrackerApi_HostAddress}}/api/v1/expenses
Content-Type: application/json
Accept: application/json

{
  "title": "Archived Budget Account Expense",
  "notes": "This expense should be rolled back.",
  "budgetAccountId": {{createStatusTestBudgetAccount.response.body.$.budgetAccountId}},
  "items": [
    {
      "itemId": {{createBudgetTestItem.response.body.$.itemId}},
      "quantity": 1.000
    }
  ]
}


###
# Attempt to update the balance of the archived budget account
#
# Archived accounts currently allow account updates according to the
# BudgetService update rule.
#
# Expected:
# - 200 OK
# - Balance becomes 1500.00
# - An Adjustment log is created with an amount of 500.00

PATCH {{ExpenseTrackerApi_HostAddress}}/api/v1/budget/accounts/{{createStatusTestBudgetAccount.response.body.$.budgetAccountId}}
Content-Type: application/json
Accept: application/json

{
  "balance": 1500.00
}


###
# Settle the budget account
#
# Expected:
# - 200 OK
# - Status is Settled

PATCH {{ExpenseTrackerApi_HostAddress}}/api/v1/budget/accounts/{{createStatusTestBudgetAccount.response.body.$.budgetAccountId}}
Content-Type: application/json
Accept: application/json

{
  "status": "Settled"
}


###
# Attempt to update a settled budget account
#
# Expected: 409 Conflict because only Open and Archived budget accounts
# may currently be updated.

PATCH {{ExpenseTrackerApi_HostAddress}}/api/v1/budget/accounts/{{createStatusTestBudgetAccount.response.body.$.budgetAccountId}}
Content-Type: application/json
Accept: application/json

{
  "balance": 2000.00
}


###
# Attempt to create an expense using a missing budget account
#
# Expected:
# - 404 Not Found
# - The expense entry and expense item are rolled back

POST {{ExpenseTrackerApi_HostAddress}}/api/v1/expenses
Content-Type: application/json
Accept: application/json

{
  "title": "Missing Budget Account Expense",
  "notes": "This expense should be rolled back.",
  "budgetAccountId": {{MissingBudgetAccountId}},
  "items": [
    {
      "itemId": {{createBudgetTestItem.response.body.$.itemId}},
      "quantity": 1.000
    }
  ]
}


###
# Retrieve all budget account logs
#
# Expected: 200 OK with the current collection of budget account logs.

GET {{ExpenseTrackerApi_HostAddress}}/api/v1/budget/logs
Accept: application/json


###
# Delete the budget account used for status tests
#
# Expected:
# - 204 No Content
# - Associated logs are deleted through ON DELETE CASCADE

