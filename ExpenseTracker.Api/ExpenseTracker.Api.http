POST {{ExpenseTrackerApi_HostAddress}}/api/v1/expenses
Content-Type: application/json
Accept: application/json

{
  "title": "Ballpen Purchase",
  "items": [
    {
      "itemId": {{createBallpen.response.body.$.itemId}},
      "quantity": 1.000
    }
  ]
}


