###
# Archive the budget account used for status mismatch tests
#
# Expected:
# - 200 OK
# - Status is Archived
# - No Adjustment activity is created because the balance is unchanged

PATCH {{ExpenseTrackerApi_HostAddress}}/api/v1/budget/accounts/{{createStatusTestBudgetAccount.response.body.$.budgetAccountId}}
Content-Type: application/json
Accept: application/json

{
  "status": "Archived"
}


###
# Attempt to record an expense using an archived budget account
#
# Expected:
# - 409 Conflict
# - The expense entry and expense item are rolled back
# - No Expense activity is created

POST {{ExpenseTrackerApi_HostAddress}}/api/v1/expenses
Content-Type: application/json
Accept: application/json

{
  "title": "Archived Budget Account Expense",
  "notes": "This expense should be rolled back.",
  "budgetAccountId": {{createStatusTestBudgetAccount.response.body.$.budgetAccountId}},
  "items": [
    {
      "itemId": {{createBudgetTestItem.response.body.$.itemId}},
      "quantity": 1.000
    }
  ]
}


###
# Change the balance of the archived budget account
#
# Archived accounts currently allow updates.
#
# Expected:
# - 200 OK
# - Balance becomes 1500.00
# - One Adjustment activity has Amount 500.00
# - BalanceBefore is 1000.00
# - BalanceAfter is 1500.00

PATCH {{ExpenseTrackerApi_HostAddress}}/api/v1/budget/accounts/{{createStatusTestBudgetAccount.response.body.$.budgetAccountId}}
Content-Type: application/json
Accept: application/json

{
  "balance": 1500.00
}


###
# Settle the budget account
#
# Expected:
# - 200 OK
# - Status is Settled

PATCH {{ExpenseTrackerApi_HostAddress}}/api/v1/budget/accounts/{{createStatusTestBudgetAccount.response.body.$.budgetAccountId}}
Content-Type: application/json
Accept: application/json

{
  "status": "Settled"
}


###
# Attempt to update a settled budget account
#
# Expected:
# - 409 Conflict
# - The balance remains 1500.00
# - No Adjustment activity is created

PATCH {{ExpenseTrackerApi_HostAddress}}/api/v1/budget/accounts/{{createStatusTestBudgetAccount.response.body.$.budgetAccountId}}
Content-Type: application/json
Accept: application/json

{
  "balance": 2000.00
}


###
# Attempt to create an expense using a missing budget account
#
# Expected:
# - 404 Not Found
# - The expense entry and expense item are rolled back
# - No account activity is created

POST {{ExpenseTrackerApi_HostAddress}}/api/v1/expenses
Content-Type: application/json
Accept: application/json

{
  "title": "Missing Budget Account Expense",
  "notes": "This expense should be rolled back.",
  "budgetAccountId": {{MissingBudgetAccountId}},
  "items": [
    {
      "itemId": {{createBudgetTestItem.response.body.$.itemId}},
      "quantity": 1.000
    }
  ]
}


###
# Retrieve all budget account activity
#
# Expected: 200 OK with the current activity collection

GET {{ExpenseTrackerApi_HostAddress}}/api/v1/budget/logs
Accept: application/json


###
# Delete the budget account used for status tests
#
# Expected:
# - 204 No Content
# - Its activity history is deleted

DELETE {{ExpenseTrackerApi_HostAddress}}/api/v1/budget/accounts/{{createStatusTestBudgetAccount.response.body.$.budgetAccountId}}
Accept: application/json


###
# Delete the catalog item used for budget tests

DELETE {{ExpenseTrackerApi_HostAddress}}/api/v1/items/{{createBudgetTestItem.response.body.$.itemId}}
Accept: application/json
