@ExpenseTrackerApi_HostAddress = https://localhost:7120

@MissingItemId = 2147483647
@MissingExpenseEntryId = 2147483647

###
# Health check through an existing endpoint

GET {{ExpenseTrackerApi_HostAddress}}/api/v1/items
Accept: application/json


###
# Create the first catalog item used by the expense tests
#
# @name createBondPaper

POST {{ExpenseTrackerApi_HostAddress}}/api/v1/items
Content-Type: application/json
Accept: application/json

{
  "name": "Expense Test Bond Paper {{$guid}}",
  "code": "BP-{{$timestamp}}",
  "brand": "PaperOne {{$guid}}",
  "unitPrice": 250.00
}


###
# Create the second catalog item used by the expense tests
#
# @name createBallpen

POST {{ExpenseTrackerApi_HostAddress}}/api/v1/items
Content-Type: application/json
Accept: application/json

{
  "name": "Expense Test Ballpen {{$guid}}",
  "code": "PEN-{{$timestamp}}",
  "brand": "Test Brand {{$guid}}",
  "unitPrice": 15.50
}


###
# Get the first created catalog item

GET {{ExpenseTrackerApi_HostAddress}}/api/v1/items/{{createBondPaper.response.body.$.itemId}}
Accept: application/json


###
# Get the second created catalog item

GET {{ExpenseTrackerApi_HostAddress}}/api/v1/items/{{createBallpen.response.body.$.itemId}}
Accept: application/json


###
# Create an expense using two different items
#
# Expected backend calculation:
# Bond paper: 250.00 * 2.000 = 500.00
# Ballpen:     15.50 * 3.000 =  46.50
# Total:                         546.50
#
# @name createExpense

POST {{ExpenseTrackerApi_HostAddress}}/api/v1/expenses
Content-Type: application/json
Accept: application/json

{
  "title": "Office Supplies",
  "notes": "HTTP file expense creation test",
  "items": [
    {
      "itemId": {{createBondPaper.response.body.$.itemId}},
      "quantity": 2.000
    },
    {
      "itemId": {{createBallpen.response.body.$.itemId}},
      "quantity": 3.000
    }
  ]
}


###
# Retrieve the newly created expense
#
# Expected:
# - Title is Office Supplies
# - Total cost is 546.50
# - Two expense item lines are returned

GET {{ExpenseTrackerApi_HostAddress}}/api/v1/expenses/{{createExpense.response.body.$.expenseEntry.expenseEntryId}}
Accept: application/json


###
# Retrieve all expenses

GET {{ExpenseTrackerApi_HostAddress}}/api/v1/expenses
Accept: application/json


###
# Create an expense containing the same item ID more than once
#
# The backend should normalize the two lines into one expense item:
# 1.250 + 2.750 = 4.000
#
# Expected total:
# 250.00 * 4.000 = 1000.00
#
# @name createExpenseWithDuplicateItemIds

POST {{ExpenseTrackerApi_HostAddress}}/api/v1/expenses
Content-Type: application/json
Accept: application/json

{
  "title": "Bulk Paper Purchase",
  "notes": "Duplicate item ID normalization test",
  "items": [
    {
      "itemId": {{createBondPaper.response.body.$.itemId}},
      "quantity": 1.250
    },
    {
      "itemId": {{createBondPaper.response.body.$.itemId}},
      "quantity": 2.750
    }
  ]
}


###
# Retrieve the normalized expense
#
# Expected:
# - One expense item line
# - Normalized quantity is 4.000
# - Total cost is 1000.00

GET {{ExpenseTrackerApi_HostAddress}}/api/v1/expenses/{{createExpenseWithDuplicateItemIds.response.body.$.expenseEntry.expenseEntryId}}
Accept: application/json


###
# Create an expense without notes
#
# Notes are optional, but title is required.
#
# @name createExpenseWithoutNotes

POST {{ExpenseTrackerApi_HostAddress}}/api/v1/expenses
Content-Type: application/json
Accept: application/json

{
  "title": "Ballpen Purchase",
  "items": [
    {
      "itemId": {{createBallpen.response.body.$.itemId}},
      "quantity": 1.000
    }
  ]
}


###
# Validation failure: empty title
#
# Expected: 400 Bad Request

POST {{ExpenseTrackerApi_HostAddress}}/api/v1/expenses
Content-Type: application/json
Accept: application/json

{
  "title": "",
  "notes": "Empty title test",
  "items": [
    {
      "itemId": {{createBondPaper.response.body.$.itemId}},
      "quantity": 1.000
    }
  ]
}


###
# Validation failure: title exceeds 100 characters
#
# The title below contains 101 characters.
# Expected: 400 Bad Request

POST {{ExpenseTrackerApi_HostAddress}}/api/v1/expenses
Content-Type: application/json
Accept: application/json

{
  "title": "AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA",
  "notes": "Title length test",
  "items": [
    {
      "itemId": {{createBondPaper.response.body.$.itemId}},
      "quantity": 1.000
    }
  ]
}


###
# Validation failure: empty items collection
#
# Expected: 400 Bad Request

POST {{ExpenseTrackerApi_HostAddress}}/api/v1/expenses
Content-Type: application/json
Accept: application/json

{
  "title": "Empty Items Test",
  "notes": "This request should fail",
  "items": []
}


###
# Validation failure: item ID must be greater than zero
#
# Expected: 400 Bad Request

POST {{ExpenseTrackerApi_HostAddress}}/api/v1/expenses
Content-Type: application/json
Accept: application/json

{
  "title": "Invalid Item Test",
  "notes": "Invalid item ID test",
  "items": [
    {
      "itemId": 0,
      "quantity": 1.000
    }
  ]
}


###
# Validation failure: quantity must be greater than zero
#
# Expected: 400 Bad Request

POST {{ExpenseTrackerApi_HostAddress}}/api/v1/expenses
Content-Type: application/json
Accept: application/json

{
  "title": "Zero Quantity Test",
  "notes": "Zero quantity test",
  "items": [
    {
      "itemId": {{createBondPaper.response.body.$.itemId}},
      "quantity": 0
    }
  ]
}


###
# Validation failure: negative quantity
#
# Expected: 400 Bad Request

POST {{ExpenseTrackerApi_HostAddress}}/api/v1/expenses
Content-Type: application/json
Accept: application/json

{
  "title": "Negative Quantity Test",
  "notes": "Negative quantity test",
  "items": [
    {
      "itemId": {{createBondPaper.response.body.$.itemId}},
      "quantity": -1.000
    }
  ]
}


###
# Validation failure: quantity has more than three decimal places
#
# Expected: 400 Bad Request

POST {{ExpenseTrackerApi_HostAddress}}/api/v1/expenses
Content-Type: application/json
Accept: application/json

{
  "title": "Quantity Scale Test",
  "notes": "Quantity scale test",
  "items": [
    {
      "itemId": {{createBondPaper.response.body.$.itemId}},
      "quantity": 1.2345
    }
  ]
}


###
# Validation failure: notes exceed 500 characters
#
# Expected: 400 Bad Request

POST {{ExpenseTrackerApi_HostAddress}}/api/v1/expenses
Content-Type: application/json
Accept: application/json

{
  "title": "Notes Length Test",
  "notes": "",
  "items": [
    {
      "itemId": {{createBondPaper.response.body.$.itemId}},
      "quantity": 1.000
    }
  ]
}


###
# Missing catalog item
#
# The item ID passes validation but does not exist.
# Expected: 404 Not Found
#
# Item validation occurs before the ExpenseEntry is inserted, so no expense
# record or expense item line should be created for this request.

POST {{ExpenseTrackerApi_HostAddress}}/api/v1/expenses
Content-Type: application/json
Accept: application/json

{
  "title": "Missing Item Test",
  "notes": "Missing item handling test",
  "items": [
    {
      "itemId": {{createBondPaper.response.body.$.itemId}},
      "quantity": 1.000
    },
    {
      "itemId": {{MissingItemId}},
      "quantity": 1.000
    }
  ]
}


###
# Missing expense entry
#
# Expected: 404 Not Found

GET {{ExpenseTrackerApi_HostAddress}}/api/v1/expenses/{{MissingExpenseEntryId}}
Accept: application/json


###
# Unknown property rejection at the parent request level
#
# Expected: 400 Bad Request

POST {{ExpenseTrackerApi_HostAddress}}/api/v1/expenses
Content-Type: application/json
Accept: application/json

{
  "title": "Unknown Parent Property Test",
  "notes": "Unknown parent property test",
  "unexpectedProperty": true,
  "items": [
    {
      "itemId": {{createBondPaper.response.body.$.itemId}},
      "quantity": 1.000
    }
  ]
}


###
# Unknown property rejection inside a nested expense item
#
# Expected: 400 Bad Request

POST {{ExpenseTrackerApi_HostAddress}}/api/v1/expenses
Content-Type: application/json
Accept: application/json

{
  "title": "Unknown Nested Property Test",
  "notes": "Unknown nested property test",
  "items": [
    {
      "itemId": {{createBondPaper.response.body.$.itemId}},
      "quantity": 1.000,
      "lineTotal": 0
    }
  ]
}


###
# Delete the first catalog item
#
# Existing expense-item snapshots should remain.
# ExpenseItems.ItemId should become null through ON DELETE SET NULL.

DELETE {{ExpenseTrackerApi_HostAddress}}/api/v1/items/{{createBondPaper.response.body.$.itemId}}
Accept: application/json


###
# Retrieve the original expense after deleting the first catalog item
#
# The expense title and parent information should remain.
# The bond-paper expense item should still contain:
# - ItemNameSnapshot
# - ItemCodeSnapshot
# - BrandSnapshot
# - UnitPriceSnapshot
# - Quantity
# - LineTotal
#
# Its ItemId should now be null.

GET {{ExpenseTrackerApi_HostAddress}}/api/v1/expenses/{{createExpense.response.body.$.expenseEntry.expenseEntryId}}
Accept: application/json


###
# Delete the second catalog item

DELETE {{ExpenseTrackerApi_HostAddress}}/api/v1/items/{{createBallpen.response.body.$.itemId}}
Accept: application/json


###
# Final retrieval of all expenses
#
# Created expense history and titles should remain after deleting source items.

GET {{ExpenseTrackerApi_HostAddress}}/api/v1/expenses
Accept: application/json
