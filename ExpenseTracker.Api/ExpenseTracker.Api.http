@ExpenseTrackerApi_HostAddress = https://localhost:7120

@MissingItemId = 2147483647
@MissingExpenseEntryId = 2147483647
@MissingBudgetAccountId = 2147483647

###
# Health check through an existing endpoint

GET {{ExpenseTrackerApi_HostAddress}}/api/v1/items
Accept: application/json


###
# Create the first catalog item used by the expense tests
#
# @name createBondPaper

POST {{ExpenseTrackerApi_HostAddress}}/api/v1/items
Content-Type: application/json
Accept: application/json

{
  "name": "Expense Test Bond Paper {{$guid}}",
  "code": "BP-{{$timestamp}}",
  "brand": "PaperOne {{$guid}}",
  "unitPrice": 250.00
}


###
# Create the second catalog item used by the expense tests
#
# @name createBallpen

POST {{ExpenseTrackerApi_HostAddress}}/api/v1/items
Content-Type: application/json
Accept: application/json

{
  "name": "Expense Test Ballpen {{$guid}}",
  "code": "PEN-{{$timestamp}}",
  "brand": "Test Brand {{$guid}}",
  "unitPrice": 15.50
}


###
# Get the first created catalog item

GET {{ExpenseTrackerApi_HostAddress}}/api/v1/items/{{createBondPaper.response.body.$.itemId}}
Accept: application/json


###
# Get the second created catalog item

GET {{ExpenseTrackerApi_HostAddress}}/api/v1/items/{{createBallpen.response.body.$.itemId}}
Accept: application/json


###
# Create an expense using two different items
#
# Expected backend calculation:
# Bond paper: 250.00 * 2.000 = 500.00
# Ballpen:     15.50 * 3.000 =  46.50
# Total:                         546.50
#
# @name createExpense

POST {{ExpenseTrackerApi_HostAddress}}/api/v1/expenses
Content-Type: application/json
Accept: application/json

{
  "title": "Office Supplies",
  "notes": "HTTP file expense creation test",
  "items": [
    {
      "itemId": {{createBondPaper.response.body.$.itemId}},
      "quantity": 2.000
    },
    {
      "itemId": {{createBallpen.response.body.$.itemId}},
      "quantity": 3.000
    }
  ]
}


###
# Retrieve the newly created expense
#
# Expected:
# - Title is Office Supplies
# - Total cost is 546.50
# - Two expense item lines are returned

GET {{ExpenseTrackerApi_HostAddress}}/api/v1/expenses/{{createExpense.response.body.$.expenseEntry.expenseEntryId}}
Accept: application/json


###
# Retrieve all expenses

GET {{ExpenseTrackerApi_HostAddress}}/api/v1/expenses
Accept: application/json


###
# Create an expense containing the same item ID more than once
#
# The backend should normalize the two lines into one expense item:
# 1.250 + 2.750 = 4.000
#
# Expected total:
# 250.00 * 4.000 = 1000.00
#
# @name createExpenseWithDuplicateItemIds

POST {{ExpenseTrackerApi_HostAddress}}/api/v1/expenses
Content-Type: application/json
Accept: application/json

{
  "title": "Bulk Paper Purchase",
  "notes": "Duplicate item ID normalization test",
  "items": [
    {
      "itemId": {{createBondPaper.response.body.$.itemId}},
      "quantity": 1.250
    },
    {
      "itemId": {{createBondPaper.response.body.$.itemId}},
      "quantity": 2.750
    }
  ]
}


###
# Retrieve the normalized expense
#
# Expected:
# - One expense item line
# - Normalized quantity is 4.000
# - Total cost is 1000.00

GET {{ExpenseTrackerApi_HostAddress}}/api/v1/expenses/{{createExpenseWithDuplicateItemIds.response.body.$.expenseEntry.expenseEntryId}}
Accept: application/json


