###
# Missing catalog item
#
# The item ID passes validation but does not exist.
# Expected: 404 Not Found
#
# Item validation occurs before the ExpenseEntry is inserted, so no expense
# record or expense item line should be created for this request.

POST {{ExpenseTrackerApi_HostAddress}}/api/v1/expenses
Content-Type: application/json
Accept: application/json

{
  "title": "Missing Item Test",
  "notes": "Missing item handling test",
  "items": [
    {
      "itemId": {{createBondPaper.response.body.$.itemId}},
      "quantity": 1.000
    },
    {
      "itemId": {{MissingItemId}},
      "quantity": 1.000
    }
  ]
}


