###
# Create a budget account
#
# Expected:
# - The account is created with an opening balance of 1000.00
# - The account status is Open
# - The response contains the generated BudgetAccountId
#
# @name createBudgetAccount

POST {{ExpenseTrackerApi_HostAddress}}/api/v1/budget/accounts
Content-Type: application/json
Accept: application/json

{
  "name": "Test Budget Account {{$guid}}",
  "description": "This is a test budget account created through the HTTP file.",
  "balance": 1000.00
}


###
# Create a budget account with an incorrect property name
#
# Expected: 400 Bad Request

POST {{ExpenseTrackerApi_HostAddress}}/api/v1/budget/accounts
Content-Type: application/json
Accept: application/json

{
  "name": "Test Budget Account {{$guid}}",
  "description": "This is a test budget account created through the HTTP file.",
  "balnce": 1000.00
}


###
# Create a budget account with an extra property
#
# Expected: 400 Bad Request

POST {{ExpenseTrackerApi_HostAddress}}/api/v1/budget/accounts
Content-Type: application/json
Accept: application/json

{
  "name": "Test Budget Account {{$guid}}",
  "description": "This is a test budget account created through the HTTP file.",
  "balance": 1000.00,
  "extraProperty": "unexpected value"
}


###
# Retrieve all budget accounts
#
# Expected:
# - The list includes the account created above
# - Accounts are ordered by name

GET {{ExpenseTrackerApi_HostAddress}}/api/v1/budget/accounts
Accept: application/json


###
# Create an expense paid from a budget account
#
# Expected calculation:
# Bond paper: 250.00 * 2.000 = 500.00
#
# Expected account result:
# Previous balance: 1000.00
# Expense amount:     500.00
# Available balance:  500.00
#
# Expected response:
# - ExpenseEntry contains the saved expense with TotalCost 500.00
# - ExpenseItems contains one historical item line
# - BudgetExpenseResult is not null
# - BudgetExpenseResult.BudgetAccount contains the updated account
# - The updated account balance is 500.00
# - BudgetExpenseResult.BudgetAccountLog contains the expense activity
# - The activity amount is -500.00
# - BalanceBefore is 1000.00
# - BalanceAfter is 500.00
# - LogType is Expense
# - ExpenseEntryId matches the newly created expense
#
# @name createExpenseWithBudgetAccount

POST {{ExpenseTrackerApi_HostAddress}}/api/v1/expenses
Content-Type: application/json
Accept: application/json

{
  "title": "Office Supplies with Budget Account",
  "notes": "HTTP file expense creation test with budget account",
  "budgetAccountId": {{createBudgetAccount.response.body.$.budgetAccountId}},
  "items": [
    {
      "itemId": {{createBondPaper.response.body.$.itemId}},
      "quantity": 2.000
    }
  ]
}


###
# Retrieve the updated budget account after the expense
#
# Expected:
# - Balance is 500.00
# - Status remains Open

GET {{ExpenseTrackerApi_HostAddress}}/api/v1/budget/accounts/{{createBudgetAccount.response.body.$.budgetAccountId}}
Accept: application/json


###
# Retrieve the account activity associated with the expense
#
# Expected:
# - BudgetAccountId matches the selected account
# - ExpenseEntryId matches the created expense
# - Amount is -500.00
# - BalanceBefore is 1000.00
# - BalanceAfter is 500.00
# - LogType is Expense
#
# These values should match the BudgetAccountLog returned in:
# createExpenseWithBudgetAccount.response.body.$.budgetExpenseResult

GET {{ExpenseTrackerApi_HostAddress}}/api/v1/budget/logs/expense-entries/{{createExpenseWithBudgetAccount.response.body.$.expenseEntry.expenseEntryId}}
Accept: application/json


###
# Retrieve all activity for the created budget account
#
# Expected:
# - One StartingBalance activity with Amount 1000.00
# - One Expense activity with Amount -500.00
# - The Expense activity has BalanceBefore 1000.00
# - The Expense activity has BalanceAfter 500.00
# - Results are ordered by LogDateTime descending

GET {{ExpenseTrackerApi_HostAddress}}/api/v1/budget/logs/accounts/{{createBudgetAccount.response.body.$.budgetAccountId}}
Accept: application/json


###
# Change the budget account balance to 5000.00
#
# Expected:
# - The updated account balance is 5000.00
# - One Adjustment activity is created
# - Amount is 4500.00
# - BalanceBefore is 500.00
# - BalanceAfter is 5000.00

PATCH {{ExpenseTrackerApi_HostAddress}}/api/v1/budget/accounts/{{createBudgetAccount.response.body.$.budgetAccountId}}
Content-Type: application/json
Accept: application/json

{
  "balance": 5000.00
}


###
# Retrieve all budget account activity after changing the balance
#
# Expected activity for the created account:
# - StartingBalance with Amount 1000.00
# - Expense with Amount -500.00
# - Adjustment with Amount 4500.00
#
# The latest activity should appear first.

GET {{ExpenseTrackerApi_HostAddress}}/api/v1/budget/logs
Accept: application/json


###
# Delete the first catalog item
#
# Existing expense-item snapshots should remain.
# ExpenseItems.ItemId should become null through ON DELETE SET NULL.

DELETE {{ExpenseTrackerApi_HostAddress}}/api/v1/items/{{createBondPaper.response.body.$.itemId}}
Accept: application/json


###
# Retrieve the original expense after deleting the first catalog item
#
# Expected:
# - The expense title and parent information remain
# - The bond-paper expense item retains its historical details
# - Its ItemId is null

GET {{ExpenseTrackerApi_HostAddress}}/api/v1/expenses/{{createExpense.response.body.$.expenseEntry.expenseEntryId}}
Accept: application/json


###
# Delete the second catalog item

DELETE {{ExpenseTrackerApi_HostAddress}}/api/v1/items/{{createBallpen.response.body.$.itemId}}
Accept: application/json


###
# Retrieve all expenses after deleting the source items
#
# Expected:
# - Expense history remains available
# - Historical item details remain available

GET {{ExpenseTrackerApi_HostAddress}}/api/v1/expenses
Accept: application/json


###
# Retrieve the expense summary
#
# Expected:
# - ExpenseCount is the total number of recorded expenses
# - TotalCost is the sum of all recorded expense totals

GET {{ExpenseTrackerApi_HostAddress}}/api/v1/expenses/entries/summary
Accept: application/json


###
# Retrieve the created budget account by ID
#
# Expected:
# - Balance is 5000.00
# - Status is Open
# - Description and timestamps are returned

GET {{ExpenseTrackerApi_HostAddress}}/api/v1/budget/accounts/{{createBudgetAccount.response.body.$.budgetAccountId}}
Accept: application/json


###
# Update the budget account name, description, and status
#
# Expected:
# - Name is Updated Test Budget Account
# - Description is Updated through the HTTP file.
# - Status is Archived
# - Balance remains 5000.00
# - No additional Adjustment activity is created

PATCH {{ExpenseTrackerApi_HostAddress}}/api/v1/budget/accounts/{{createBudgetAccount.response.body.$.budgetAccountId}}
Content-Type: application/json
Accept: application/json

{
  "name": "Updated Test Budget Account",
  "description": "Updated through the HTTP file.",
  "status": "Archived"
}


###
# Retrieve the budget account after updating its details and status
#
# Expected:
# - Name is Updated Test Budget Account
# - Description is Updated through the HTTP file.
# - Status is Archived
# - Balance remains 5000.00

GET {{ExpenseTrackerApi_HostAddress}}/api/v1/budget/accounts/{{createBudgetAccount.response.body.$.budgetAccountId}}
Accept: application/json


###
# Retrieve the account activity after updating details and status
#
# Expected:
# - No additional Adjustment activity was created
# - Existing StartingBalance, Expense, and Adjustment activities remain

GET {{ExpenseTrackerApi_HostAddress}}/api/v1/budget/logs/accounts/{{createBudgetAccount.response.body.$.budgetAccountId}}
Accept: application/json


