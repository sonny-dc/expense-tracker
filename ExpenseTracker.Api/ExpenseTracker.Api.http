  "items": [
    {
      "itemId": {{createBondPaper.response.body.$.itemId}},
      "quantity": 1.000,
      "lineTotal": 0
    }
  ]
}


###
# Create a budget account
#
# Returns the new budget account ID and the initial balance.
# @name createBudgetAccount

POST {{ExpenseTrackerApi_HostAddress}}/api/v1/budget/accounts
Content-Type: application/json
Accept: application/json

{
  "Name": "Test Budget Account {{$guid}}",
  "Description": "This is a test budget account created through the HTTP file.",
  "Balance": 1000.00
}


###
# Create a budget account with incorrect property names
#
# Expected: 400 Bad Request

POST {{ExpenseTrackerApi_HostAddress}}/api/v1/budget/accounts
Content-Type: application/json
Accept: application/json

{
  "Name": "Test Budget Account {{$guid}}",
  "Description": "This is a test budget account created through the HTTP file.",
  "Balnce": 1000.00
}


###
# Create a budget account with extra properties that don't exist in the model
#
# Expected: 400 Bad Request

POST {{ExpenseTrackerApi_HostAddress}}/api/v1/budget/accounts
Content-Type: application/json
Accept: application/json

{
  "name": "Test Budget Account {{$guid}}",
  "description": "This is a test budget account created through the HTTP file.",
  "Balance": 1000.00,
  "extraProperty": "unexpected value"
}


###
# Retrieve all budget accounts
#
# Expected: The list of budget accounts, including the one created above.

GET {{ExpenseTrackerApi_HostAddress}}/api/v1/budget/accounts
Accept: application/json


###
# Create an expense with an associated budget account
#
# Expected: The expense
# @name createExpenseWithBudgetAccount

POST {{ExpenseTrackerApi_HostAddress}}/api/v1/expenses
Content-Type: application/json
Accept: application/json

{
  "title": "Office Supplies with Budget Account",
  "notes": "HTTP file expense creation test with budget account",
  "budgetAccountId": {{createBudgetAccount.response.body.$.budgetAccountId}},
  "items": [
    {
      "itemId": {{createBondPaper.response.body.$.itemId}},
      "quantity": 2.000
    }
  ]
}


###
# Retrieve the BudgetAccountLog associated with the expense created above
#
# Expected: The budget account log entry for the expense, including the
# budget account ID, expense entry ID, and the amount deducted from the budget account.

GET {{ExpenseTrackerApi_HostAddress}}/api/v1/budget/logs/expense-entries/{{createExpenseWithBudgetAccount.response.body.$.expenseEntry.expenseEntryId}}
Accept: application/json

###
# Retrieve the budget account logs based on the budget account ID
#
# Expected: The budget account log entry for the expense, including the
# budget account ID, expense entry ID, and the amount deducted from the budget account.

GET {{ExpenseTrackerApi_HostAddress}}/api/v1/budget/logs/accounts/{{createBudgetAccount.response.body.$.budgetAccountId}}
Accept: application/json


###
# Update the budget account balance to 5000
#
# Expected: The updated budget account with the new balance of 5000.00.

PATCH {{ExpenseTrackerApi_HostAddress}}/api/v1/budget/accounts/{{createBudgetAccount.response.body.$.budgetAccountId}}
Content-Type: application/json
Accept: application/json

{
  "balance": 5000.00
}


###
# Get the log entries for the budget account after updating the balance
#
# Expected: The budget account log entry for the balance update, including the
# 'Adjustment' logType, budget account ID, the new balance, and the timestamp of the update.

GET {{ExpenseTrackerApi_HostAddress}}/api/v1/budget/logs
Accept: application/json


###
# Delete the first catalog item
#
# Existing expense-item snapshots should remain.
# ExpenseItems.ItemId should become null through ON DELETE SET NULL.

DELETE {{ExpenseTrackerApi_HostAddress}}/api/v1/items/{{createBondPaper.response.body.$.itemId}}
Accept: application/json


###
# Retrieve the original expense after deleting the first catalog item
#
# The expense title and parent information should remain.
# The bond-paper expense item should still contain:
# - ItemNameSnapshot
# - ItemCodeSnapshot
# - BrandSnapshot
# - UnitPriceSnapshot
# - Quantity
# - LineTotal
#
# Its ItemId should now be null.

GET {{ExpenseTrackerApi_HostAddress}}/api/v1/expenses/{{createExpense.response.body.$.expenseEntry.expenseEntryId}}
Accept: application/json


###
# Delete the second catalog item

DELETE {{ExpenseTrackerApi_HostAddress}}/api/v1/items/{{createBallpen.response.body.$.itemId}}
Accept: application/json


###
# Final retrieval of all expenses
#
# Created expense history and titles should remain after deleting source items.

GET {{ExpenseTrackerApi_HostAddress}}/api/v1/expenses
Accept: application/json


###
# Retrieve the expense summary
#
# Returns the total number of expenses and the total cost of all expenses.

GET {{ExpenseTrackerApi_HostAddress}}/api/v1/expenses/entries/summary
Accept: application/json


###
# Retrieve the created budget account by ID
#
# Expected: The created budget account with its current balance, status,
# description, and timestamps.

GET {{ExpenseTrackerApi_HostAddress}}/api/v1/budget/accounts/{{createBudgetAccount.response.body.$.budgetAccountId}}
Accept: application/json


###
# Update the budget account name, description, and status
#
# Expected: The updated budget account with the new name, description,
# and Archived status. The balance should remain unchanged.

PATCH {{ExpenseTrackerApi_HostAddress}}/api/v1/budget/accounts/{{createBudgetAccount.response.body.$.budgetAccountId}}
Content-Type: application/json
Accept: application/json

{
  "name": "Updated Test Budget Account",
  "description": "Updated through the HTTP file.",
  "status": "Archived"
}


###
# Retrieve the budget account after updating its metadata and status
#
# Expected:
# - Name is Updated Test Budget Account
# - Description is Updated through the HTTP file.
# - Status is Archived
# - Balance remains unchanged

GET {{ExpenseTrackerApi_HostAddress}}/api/v1/budget/accounts/{{createBudgetAccount.response.body.$.budgetAccountId}}
Accept: application/json


###
# Retrieve the budget account logs after updating metadata and status
#
# Expected: No additional Adjustment log should be created because the
# balance was not changed by the previous request.

GET {{ExpenseTrackerApi_HostAddress}}/api/v1/budget/logs/accounts/{{createBudgetAccount.response.body.$.budgetAccountId}}
Accept: application/json


